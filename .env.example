# With no .env at all, the app talks to the mock (http://localhost:3001, or
# http://mock:3001 under docker compose) using the mock key.

# For the real API, uncomment all three settings below and replace the key and
# password placeholders. Keep the filled-in values in your ignored .env only.
# The app calls ${PARASAIL_BASE_URL}/v1/...
# PARASAIL_BASE_URL=https://api.parasail.io/api/v1/openai
# PARASAIL_API_KEY=psk-<accesskey>-<secretkey>

# A sign-in page in front of the page and every /api route but health (scripts can
# send it as Basic Auth instead, any username).
# Required with the real API (the server won't start without it). Unset = no
# gate (the mock).
# PLAYGROUND_PASSWORD=<your-private-preview-password>

# ?_simulate=N, fault switches and Weather control.
# Default: on against the mock, off against the real API.
# PLAYGROUND_FAULTS=true

# PORT=3000
